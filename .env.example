# Reddit: usually NOTHING to set here. `pnpm run setup` auto-borrows your browser's
# reddit.com cookies (bypasses Reddit's anonymous 403) - no Reddit account or app needed.
# REDDIT_COOKIE=                 # set automatically by setup; or paste a reddit.com Cookie header
# REDDIT_COOKIE_FROM=chrome      # auto-read reddit cookies from this browser on every start
#
# Reddit API Credentials (ONLY needed as a last resort if cookies don't get past the block)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Reddit User Credentials (optional, for posting/commenting)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Authentication Mode (optional, defaults to 'auto')
# auto         - Use OAuth if credentials exist, fallback to anonymous (default)
# authenticated - Require OAuth, fail if no credentials
# anonymous    - Always use public JSON API (no auth, ~10 req/min)
REDDIT_AUTH_MODE=auto

# Transport Configuration
# TRANSPORT_TYPE=stdio  # Uncomment for stdio mode (default: httpStream for direct node execution, stdio for npx/bin)
PORT=3000               # HTTP server port (default: 3000, only used when TRANSPORT_TYPE is httpStream or not set)
# HOST=0.0.0.0          # HTTP server host (default: 0.0.0.0, binds to all interfaces for Docker)

# OAuth Settings for HTTP Server (optional)
OAUTH_ENABLED=false
OAUTH_TOKEN=

# ─────────────────────────── Facebook (groups + pages) ───────────────────────────
# EASIEST: don't set anything here — just run `pnpm run setup`, which auto-grabs your
# Facebook login from your browser and fills in FACEBOOK_COOKIE for you.
#
# Or let the server auto-read cookies from a logged-in browser on every start:
# FACEBOOK_COOKIE_FROM=chrome           # chrome | brave | edge | arc | chromium | vivaldi | opera
# FACEBOOK_COOKIE_FROM_PROFILE=Default  # browser profile name
#
# Or paste the session cookie manually (whole Cookie header; needs c_user + xs).
# Treat these as secrets.
FACEBOOK_COOKIE=
# Alternatively, provide cookie parts individually:
# FACEBOOK_C_USER=
# FACEBOOK_XS=
# FACEBOOK_DATR=

# Scraping engine: auto (default), http (lightweight fetch), browser (Playwright).
# The browser engine is the most reliable for private groups + full comment threads.
# Install it once with: npm install playwright && npx playwright install chromium
FACEBOOK_ENGINE=auto
# FACEBOOK_HEADLESS=true          # Run the browser engine headless (true/false)
# FACEBOOK_MIN_DELAY_MS=4000      # Min delay between Facebook requests (anti-bot pacing)
# FACEBOOK_LOCALE=en_US           # Preferred locale
# FACEBOOK_USER_AGENT=            # Override the User-Agent
# FACEBOOK_CACHE=on               # In-memory response cache (on/off)
# FACEBOOK_CACHE_MAX_MB=50        # Cache size cap in MB

# ─────────────────────────── Amazon (product reviews) ───────────────────────────
# EASIEST: don't set anything here — just run `pnpm run setup`, which also grabs your
# amazon.com login from your browser (macOS/Linux) so it can read full review history.
#
# Amazon shows logged-out visitors only a handful of reviews. Three ways to read more:
#   1) nothing            — the http engine reads the first public reviews (quick look)
#   2) your login         — set AMAZON_COOKIE (or run setup) to page deeper (recommended, free)
#   3) a paid reviews API — set AMAZON_API_KEY for the most reliable path (handles anti-bot)
#
# Paste a logged-in amazon.com Cookie header here (or let setup fill it in). Treat as a secret.
AMAZON_COOKIE=
# Or auto-read your Amazon login from a browser on every start:
# AMAZON_COOKIE_FROM=chrome              # chrome | brave | edge | arc | chromium | vivaldi | opera
# AMAZON_COOKIE_FROM_PROFILE=Default

# Scraping engine: auto (default), http (lightweight fetch), browser (Playwright), api (paid API).
AMAZON_ENGINE=auto
# AMAZON_API_KEY=                 # Paid reviews API key (Unwrangle or Rainforest)
# AMAZON_API_PROVIDER=unwrangle   # unwrangle (default) or rainforest
# AMAZON_MARKETPLACE=com          # Default store when you pass only an ASIN (com, co.uk, de, …)
# AMAZON_MIN_DELAY_MS=3000        # Min delay between Amazon requests (anti-bot pacing)
# AMAZON_MAX_REVIEW_PAGES=10      # Cap on review pages fetched per product (~10 reviews/page)
# AMAZON_HEADLESS=true            # Run the browser engine headless (true/false)
# AMAZON_LOCALE=en_US             # Preferred locale
# AMAZON_USER_AGENT=             # Override the User-Agent
# AMAZON_CACHE=on                 # In-memory response cache (on/off)
# AMAZON_CACHE_MAX_MB=50          # Cache size cap in MB

# ─────────────────────────── Meta Ad Library (competitor ad spying) ───────────────────────────
# Scrape the PUBLIC Meta (Facebook/Instagram) Ad Library: find a brand's advertiser pages by its bare
# domain, then pull their ads (copy, CTA, media, run-length). The Ad Library is public, so no login is
# required - a Facebook session only smooths Meta's anti-bot defences. By default this REUSES the
# FACEBOOK_COOKIE you set above (run `pnpm run setup`), so usually nothing here needs configuring.
# META_ADS_COOKIE=                # Optional: a separate facebook.com Cookie header (else reuses FACEBOOK_COOKIE)
# META_ADS_COOKIE_FROM=chrome     # Or auto-read facebook.com cookies: chrome|brave|edge|arc|chromium|vivaldi|opera
# META_ADS_COOKIE_FROM_PROFILE=Default
META_ADS_ENGINE=auto              # auto (default), http, browser (Playwright - most robust), api (paid provider)
# META_ADS_COUNTRY=US             # Default Ad Library country (ISO code, or ALL)
# META_ADS_API_KEY=               # Optional paid provider key (ScrapeCreators) - reliable at scale
# META_ADS_API_PROVIDER=scrapecreators
# META_ADS_MIN_DELAY_MS=5000      # Min delay between requests (anti-bot pacing; higher - no proxies)
# META_ADS_MAX_PAGES=10           # Cap on result pages fetched per query (~30 ads/page)
# META_ADS_DOWNLOAD_DIR=meta-ads-creatives  # Where meta_ads_download_creatives saves creative files
# Video transcription (local whisper.cpp, no API key): `brew install ffmpeg whisper-cpp` + a model in
# ~/.whisper-models (e.g. ggml-base.en.bin from huggingface.co/ggerganov/whisper.cpp). Then downloading
# videos auto-saves a .txt script + a combined .script.md (ad copy + spoken script).
# META_ADS_WHISPER_MODEL=         # Path to a ggml whisper model (else best one in ~/.whisper-models)
# META_ADS_WHISPER_FAST=false     # Greedy decoding (faster, lower quality) - good for CPU-only machines
# META_ADS_WHISPER_THREADS=8      # Whisper CPU threads
# META_ADS_HEADLESS=true          # Run the browser engine headless (true/false)
# META_ADS_LOCALE=en_US           # Preferred locale
# META_ADS_USER_AGENT=            # Override the User-Agent
# META_ADS_CACHE=on               # In-memory response cache (on/off)
# META_ADS_CACHE_MAX_MB=50        # Cache size cap in MB
